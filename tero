#!/usr/bin/env bash
# Levanta Tero completo: daemon + boca. Ctrl+C corta los dos.
#
# Verifica las dependencias externas antes de arrancar (Ollama, el modelo,
# token de Spotify, binarios de sistema) en vez de dejar que cada una
# falle más tarde y por separado, adentro del daemon, donde el error
# aparece como un traceback a mitad de una conversación.
#
# El chequeo de instancia única no es decorativo: dos daemons a la vez
# cargan dos veces Whisper large-v3 en la GPU y el segundo muere con
# "CUDA failed with error out of memory" (pasado de verdad).

set -uo pipefail

cd "$(dirname "$(readlink -f "$0")")" || exit 1

DIR_LOGS="logs"
LOG="$DIR_LOGS/tero.log"
LOG_BOCA="$DIR_LOGS/boca.log"
LOCK="$DIR_LOGS/.lock"

ESPERA_DAEMON_S=180 # la primera vez Whisper se baja de HuggingFace
ESPERA_BOCA_S=30

mkdir -p "$DIR_LOGS"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_MAL=$'\033[31m'; C_AVISO=$'\033[33m'
  C_TENUE=$'\033[2m'; C_FIN=$'\033[0m'
else
  C_OK=""; C_MAL=""; C_AVISO=""; C_TENUE=""; C_FIN=""
fi

_a_log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$1" >>"$LOG"; }
paso()  { printf '  %s…%s %s\n' "$C_TENUE" "$C_FIN" "$1"; _a_log "-> $1"; }
ok()    { printf '  %s✓%s %s\n' "$C_OK" "$C_FIN" "$1";    _a_log "ok: $1"; }
aviso() { printf '  %s!%s %s\n' "$C_AVISO" "$C_FIN" "$1"; _a_log "aviso: $1"; }
error() { printf '  %s✗%s %s\n' "$C_MAL" "$C_FIN" "$1";   _a_log "ERROR: $1"; }

PID_DAEMON=""
PID_BOCA=""
PID_TAIL=""
YA_MATE=0

matar() {
  # El trap está en EXIT además de INT/TERM, así que sin este guard corre
  # dos veces (una por la señal, otra por la salida) y saluda dos veces.
  [ $YA_MATE -eq 1 ] && return
  YA_MATE=1
  printf '\n'
  # El tail primero: `wait` de abajo se cuelga para siempre si sigue vivo
  # (es un hijo más del script, y `tail -f` no termina solo).
  [ -n "$PID_TAIL" ] && kill -TERM "$PID_TAIL" 2>/dev/null
  for pid in "$PID_BOCA" "$PID_DAEMON"; do
    [ -n "$pid" ] || continue
    # Al hijo real (python) además del padre: `uv run` es un wrapper y
    # matarlo solo a él puede dejar el python huérfano y vivo.
    pkill -TERM -P "$pid" 2>/dev/null
    kill -TERM "$pid" 2>/dev/null
  done
  wait "$PID_DAEMON" "$PID_BOCA" 2>/dev/null
  _a_log "Tero cortado."
  printf '%sChau.%s\n' "$C_TENUE" "$C_FIN"
}
trap matar EXIT INT TERM

printf '\n%sTero%s\n' "$C_TENUE" "$C_FIN"

# --- una sola instancia ---------------------------------------------------
# Esto va ANTES de tocar el log: si una segunda corrida rotara el log y
# después se rechazara a sí misma, le dejaría el log truncado a la corrida
# buena, que se queda esperando para siempre una línea que ya no está
# (pasó de verdad al probar el script).
exec 9>"$LOCK"
if ! flock -n 9; then
  error "Ya hay un Tero corriendo (lanzado con este mismo script)."
  exit 1
fi
if pgrep -f "$PWD/.venv/bin/python.* main.py" >/dev/null 2>&1; then
  error "Ya hay un daemon de Tero corriendo, lanzado a mano y por fuera de este script."
  printf '      Cortalo con: %spkill -f "%s/.venv/bin/python.* main.py"%s\n' \
    "$C_TENUE" "$PWD" "$C_FIN"
  exit 1
fi

# Log nuevo por corrida, conservando el anterior: si algo falló recién, el
# log de esa corrida no se pierde al reintentar.
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
: >"$LOG"

ok "No hay otra instancia corriendo"

# --- dependencias ---------------------------------------------------------
if ! curl -sf --max-time 5 http://localhost:11434/api/tags >/dev/null 2>&1; then
  error "Ollama no responde en localhost:11434."
  printf '      Arrancalo con: %ssystemctl start ollama%s\n' "$C_TENUE" "$C_FIN"
  exit 1
fi

MODELO=$(awk '/^\[cerebro\]/{f=1;next} /^\[/{f=0} f && /^ *modelo/ {gsub(/.*= *"|"/,""); print; exit}' config.toml)
if [ -n "$MODELO" ] && ! curl -sf --max-time 5 http://localhost:11434/api/tags | grep -q "\"$MODELO\""; then
  error "Ollama anda pero no tiene el modelo '$MODELO'."
  printf '      Bajalo con: %sollama pull %s%s\n' "$C_TENUE" "$MODELO" "$C_FIN"
  exit 1
fi
ok "Ollama activo${MODELO:+ (modelo $MODELO)}"

if [ -f "$HOME/.config/tero/spotify_token.json" ]; then
  ok "Spotify logueado"
else
  aviso "Spotify sin loguear: la música no va a andar (uv run python -m herramientas._spotify_auth)"
fi

faltantes=""
for binario in playerctl wpctl pw-dump wmctrl notify-send; do
  command -v "$binario" >/dev/null 2>&1 || faltantes="$faltantes $binario"
done
if [ -n "$faltantes" ]; then
  aviso "Faltan binarios de sistema:$faltantes (ver INSTALACIONES.md)"
else
  ok "Binarios de sistema presentes"
fi

# --- daemon ---------------------------------------------------------------
paso "Arrancando el daemon (carga Whisper y la voz, tarda unos segundos)"
uv run python main.py >>"$LOG" 2>&1 &
PID_DAEMON=$!

hito_stt=0
hito_tts=0
hito_llm=0
listo=0
for _ in $(seq $((ESPERA_DAEMON_S * 2))); do
  if ! kill -0 "$PID_DAEMON" 2>/dev/null; then
    error "El daemon se murió al arrancar. Últimas líneas:"
    tail -n 15 "$LOG" | sed 's/^/      /'
    exit 1
  fi
  if [ $hito_stt -eq 0 ] && grep -q "Cargando modelo de transcripción" "$LOG"; then
    hito_stt=1; paso "Cargando el modelo de transcripción"
  fi
  if [ $hito_tts -eq 0 ] && grep -q "Cargando voz" "$LOG"; then
    hito_tts=1; ok "Modelo de transcripción cargado"; paso "Cargando la voz"
  fi
  if [ $hito_llm -eq 0 ] && grep -q "Cargando modelo de lenguaje" "$LOG"; then
    hito_llm=1; ok "Voz cargada"; paso "Cargando el modelo de lenguaje (recién reiniciada la máquina tarda)"
  fi
  if grep -q "Tero escuchando" "$LOG"; then listo=1; break; fi
  sleep 0.5
done

if [ $listo -eq 0 ]; then
  error "El daemon no terminó de arrancar en ${ESPERA_DAEMON_S}s. Últimas líneas:"
  tail -n 15 "$LOG" | sed 's/^/      /'
  exit 1
fi
ok "Modelo de lenguaje cargado"
TECLA=$(grep -m1 "Tero escuchando" "$LOG" | sed 's/.*Mantené \(.*\) para hablar.*/\1/')
ok "Daemon escuchando${TECLA:+ (tecla: $TECLA)}"

# --- boca -----------------------------------------------------------------
# Cliente opcional: si no levanta, el daemon sigue andando igual (es una
# regla del proyecto, no una casualidad). Por eso acá nunca se sale con
# error, solo se avisa.

# Si está puesta la boca-extensión de GNOME (boca-gnome/), ya hay una boca
# dibujándose adentro de gnome-shell: levantar además la de pywebview
# pondría dos ondas superpuestas, y la pesada de las dos.
if gnome-extensions list --enabled 2>/dev/null | grep -q "^boca@tero.local$"; then
  ok "Boca: usando la extensión de GNOME (no hace falta la de pywebview)"
  BOCA_POR_EXTENSION=1
else
  BOCA_POR_EXTENSION=0
fi

if [ $BOCA_POR_EXTENSION -eq 0 ]; then
paso "Arrancando la boca (overlay)"
: >"$LOG_BOCA"
QT_QPA_PLATFORM=xcb uv run python -m boca.ventana >>"$LOG_BOCA" 2>&1 &
PID_BOCA=$!

boca_lista=0
for _ in $(seq $((ESPERA_BOCA_S * 2))); do
  if ! kill -0 "$PID_BOCA" 2>/dev/null; then break; fi
  if wmctrl -l 2>/dev/null | grep -q "tero-boca"; then boca_lista=1; break; fi
  sleep 0.5
done

if [ $boca_lista -eq 1 ]; then
  ok "Boca en pantalla"
else
  aviso "La boca no levantó (el daemon sigue andando igual). Ver $LOG_BOCA"
fi
fi  # fin del bloque de la boca de pywebview

# --- listo ----------------------------------------------------------------
printf '\n  %sTodo listo.%s Ctrl+C para cortar todo.\n' "$C_OK" "$C_FIN"
printf '  %sLog: %s  ·  boca: %s%s\n\n' "$C_TENUE" "$LOG" "$LOG_BOCA" "$C_FIN"
_a_log "Todo listo (daemon $PID_DAEMON, boca ${PID_BOCA:-—})."

# Log en vivo del daemon, que es lo que interesa mirar mientras se usa.
tail -n 0 -f "$LOG" &
PID_TAIL=$!


# Si el daemon se cae solo, no dejar el script colgado mostrando un log muerto.
wait "$PID_DAEMON"
SALIDA_DAEMON=$?
kill "$PID_TAIL" 2>/dev/null
# Si venimos de un Ctrl+C esto no es una caída, es lo que se pidió.
if [ $YA_MATE -eq 0 ]; then
  if [ "$SALIDA_DAEMON" -eq 3 ]; then
    # Código 3 = el monitor de salud de salud.py decidió cerrar. No es una
    # caída: el motivo ya está explicado en el log.
    printf '\n'
    aviso "Tero se cerró solo para cuidar el equipo:"
    grep "Cerrando Tero para cuidar el equipo" "$LOG" | tail -n 1 | sed 's/^.*equipo: /      /'
    exit 0
  fi
  error "El daemon se cayó solo. Últimas líneas:"
  tail -n 15 "$LOG" | sed 's/^/      /'
  exit 1
fi
